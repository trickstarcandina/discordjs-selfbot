{
  "name": "@trickstarcandina/discordjs-selfbot",
  "version": "0.3.0",
  "description": "discord.js v14 for Discord user accounts: relationships, group DMs, rich presence, and voice with DAVE end-to-end encryption",
  "keywords": [
    "discord.js",
    "selfbot",
    "djs",
    "api",
    "bot",
    "node",
    "discord",
    "client",
    "discordapp",
    "discordjs"
  ],
  "homepage": "https://github.com/trickstarcandina/discordjs-selfbot#readme",
  "bugs": {
    "url": "https://github.com/trickstarcandina/discordjs-selfbot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trickstarcandina/discordjs-selfbot.git"
  },
  "main": "./src/index.js",
  "types": "./typings/index.d.ts",
  "scripts": {
    "test": "node --test && npm run test:typescript",
    "lint": "eslint src test scripts eslint.config.mjs",
    "lint:fix": "eslint src test scripts eslint.config.mjs --fix",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\"",
    "test:typescript": "tsc --noEmit && tsd --files typings/index.test-d.ts && tsd --files typings/selfbot.test-d.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "audit:all": "npm audit --audit-level=high",
    "audit:signatures": "npm audit signatures",
    "check:package": "node scripts/check-package.mjs",
    "security": "npm run audit:prod && npm run audit:all && node --test test/security.test.js && npm run check:package",
    "smoke:login": "node scripts/smoke/login.mjs",
    "smoke:readonly": "node --env-file=.env scripts/smoke/readonly.mjs",
    "prepare": "husky",
    "smoke:write": "node --env-file=.env scripts/smoke/write.mjs",
    "smoke:message": "node --env-file=.env scripts/smoke/message.mjs",
    "smoke:voice": "node --env-file=.env scripts/smoke/voice.mjs",
    "smoke:interaction": "node --env-file=.env scripts/smoke/interaction.mjs",
    "smoke:groupdm": "node --env-file=.env scripts/smoke/groupdm.mjs"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE-APACHE",
    "NOTICE",
    "src",
    "typings",
    "!typings/*.test-d.ts"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@discordjs/builders": "^1.11.2",
    "@discordjs/collection": "1.5.3",
    "@discordjs/formatters": "^0.6.1",
    "@discordjs/rest": "2.6.3",
    "@discordjs/util": "^1.1.1",
    "@discordjs/ws": "1.2.3",
    "@sapphire/snowflake": "3.5.5",
    "discord-api-types": "^0.38.57",
    "fast-deep-equal": "3.1.3",
    "find-process": "^2.1.1",
    "lodash.snakecase": "4.1.1",
    "magic-bytes.js": "^1.13.0",
    "prism-media": "^1.3.5",
    "qrcode": "^1.5.4",
    "tree-kill": "^1.2.2",
    "tslib": "^2.6.3",
    "undici": "^8.12.3",
    "werift-rtp": "^0.8.9",
    "ws": "^8.22.0"
  },
  "optionalDependencies": {
    "@snazzah/davey": "^0.1.12",
    "zlib-sync": "^0.1.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "~65.2.2",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "opusscript": "^0.0.8",
    "prettier": "^3.9.10",
    "tsd": "^0.33.0",
    "typescript": "^5.5.4"
  },
  "author": "trickstarcandina"
}
